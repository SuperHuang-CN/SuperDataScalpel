<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.0</version>
        <relativePath/>
    </parent>

    <groupId>cn.superhuang</groupId>
    <artifactId>data-scalpel</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>DataScalpel Backend</name>
    <description>DataScalpel backend foundation</description>

    <modules>
        <module>data-scalpel-task-sdk</module>
        <module>data-scalpel-task-sdk-testkit</module>
        <module>data-scalpel-contracts</module>
        <module>data-scalpel-web-core</module>
        <module>data-scalpel-dialect</module>
        <module>data-scalpel-business</module>
        <module>data-scalpel-admin</module>
        <module>data-scalpel-service-engine</module>
        <module>data-scalpel-task-engine</module>
        <module>data-scalpel-task-dispatcher</module>
        <module>data-scalpel-filegdb</module>
        <module>data-scalpel-filegdb-s3</module>
        <module>data-scalpel-shapefile</module>
        <module>data-scalpel-shapefile-s3</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <maven.compiler.release>21</maven.compiler.release>
        <maven.compiler.parameters>true</maven.compiler.parameters>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <super-api-studio.version>3.0.0-SNAPSHOT</super-api-studio.version>
        <springdoc.version>3.0.3</springdoc.version>
        <clickhouse-jdbc.version>0.9.8</clickhouse-jdbc.version>
        <dameng-jdbc.version>8.1.3.140</dameng-jdbc.version>
        <kingbase-jdbc.version>8.6.1</kingbase-jdbc.version>
        <opengauss-jdbc.version>6.0.0-og</opengauss-jdbc.version>
        <tdengine-jdbc.version>3.6.3</tdengine-jdbc.version>
        <aws.sdk.version>2.46.8</aws.sdk.version>
        <apache.poi.version>5.5.1</apache.poi.version>
        <parquet.version>1.17.1</parquet.version>
        <hadoop.version>3.3.0</hadoop.version>
        <apache.avro.version>1.12.1</apache.avro.version>
        <snappy-java.version>1.1.10.8</snappy-java.version>
        <xz.version>1.10</xz.version>
        <zstd-jni.version>1.5.7-4</zstd-jni.version>
        <jsqlparser.version>5.3</jsqlparser.version>
        <jts.version>1.20.0</jts.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.locationtech.jts</groupId>
                <artifactId>jts-core</artifactId>
                <version>${jts.version}</version>
            </dependency>
            <dependency>
                <groupId>com.github.jsqlparser</groupId>
                <artifactId>jsqlparser</artifactId>
                <version>${jsqlparser.version}</version>
            </dependency>
            <dependency>
                <groupId>cn.superhuang.superops.api.studio</groupId>
                <artifactId>super-api-studio-boot-starter</artifactId>
                <version>${super-api-studio.version}</version>
            </dependency>
            <dependency>
                <groupId>cn.superhuang</groupId>
                <artifactId>data-scalpel-task-sdk</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>cn.superhuang</groupId>
                <artifactId>data-scalpel-task-sdk-testkit</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>cn.superhuang</groupId>
                <artifactId>data-scalpel-contracts</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>cn.superhuang</groupId>
                <artifactId>data-scalpel-web-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>cn.superhuang</groupId>
                <artifactId>data-scalpel-dialect</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>cn.superhuang</groupId>
                <artifactId>data-scalpel-business</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>cn.superhuang</groupId>
                <artifactId>data-scalpel-service-engine</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>cn.superhuang</groupId>
                <artifactId>data-scalpel-task-dispatcher</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>cn.superhuang</groupId>
                <artifactId>data-scalpel-filegdb</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>cn.superhuang</groupId>
                <artifactId>data-scalpel-filegdb-s3</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>cn.superhuang</groupId>
                <artifactId>data-scalpel-shapefile</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>cn.superhuang</groupId>
                <artifactId>data-scalpel-shapefile-s3</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
