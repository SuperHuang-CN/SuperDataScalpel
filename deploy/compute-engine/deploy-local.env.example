# This file is copied to deploy-local.env on the first run.
# deploy-local.env is ignored by Git. Replace every <set-me> value before deploying.

LOCAL_JAVA_HOME=D:\Program Files\Eclipse Adoptium\jdk-21.0.11.10-hotspot
SSH_TARGET=linux69
REMOTE_HOST_IP=10.0.0.69
REMOTE_ROOT=/data/datascalpel-compute-engine

# Optional. When an API key is present, the script creates/updates a managed
# Portainer Stack. Without it, the script uses docker compose over SSH; the
# project is still visible in Portainer as an externally managed Stack.
PORTAINER_URL=https://10.0.0.69:9443
PORTAINER_API_KEY=
PORTAINER_ENDPOINT_ID=
PORTAINER_SKIP_TLS_VERIFY=true

DATASCALPEL_TASK_DISPATCHER_TOKEN=
DATASCALPEL_TASK_DISPATCHER_ENSURE_TOPICS=true

DATASCALPEL_DB_URL=jdbc:postgresql://home.superhuang.cn:5432/datascalpel
DATASCALPEL_TASK_DISPATCHER_DB_SCHEMA=dispatcher69
DATASCALPEL_DB_USERNAME=datascalpel
DATASCALPEL_DB_PASSWORD=<set-me>

DATASCALPEL_KAFKA_BOOTSTRAP_SERVERS=home.superhuang.cn:9094
DATASCALPEL_KAFKA_RUNNER_BOOTSTRAP_SERVERS=home.superhuang.cn:9094

DATASCALPEL_FILE_STORAGE_ENDPOINT=http://home.superhuang.cn:9000
DATASCALPEL_FILE_STORAGE_RUNNER_ENDPOINT=http://home.superhuang.cn:9000
DATASCALPEL_FILE_STORAGE_REGION=us-east-1
DATASCALPEL_FILE_STORAGE_BUCKET=datascalpel
DATASCALPEL_FILE_STORAGE_ROOT_PREFIX=data-scalpel
DATASCALPEL_FILE_STORAGE_ACCESS_KEY=minioadmin
DATASCALPEL_FILE_STORAGE_SECRET_KEY=<set-me>
DATASCALPEL_FILE_STORAGE_PATH_STYLE_ACCESS=true

DATASCALPEL_TASK_DISPATCHER_DOCKER_IMAGE=eclipse-temurin:21-jdk
DATASCALPEL_TASK_DISPATCHER_DOCKER_PULL=missing
DATASCALPEL_TASK_DISPATCHER_DOCKER_MEMORY=4g
DATASCALPEL_TASK_DISPATCHER_DOCKER_CPUS=2
DATASCALPEL_TASK_DISPATCHER_RUNNER_JAVA_OPTIONS=-Xms512m -Xmx3g

DATASCALPEL_COMMAND_TOPIC=datascalpel.execution.command.linux69
DATASCALPEL_RUNNER_EVENT_TOPIC=datascalpel.runner.event.linux69
DATASCALPEL_ADMIN_EVENT_TOPIC=datascalpel.execution.event
DATASCALPEL_MAX_QUEUED_EXECUTIONS=100
DATASCALPEL_MAX_CONCURRENT_SUBMISSIONS=2
DATASCALPEL_MAX_IN_FLIGHT_APPLICATIONS=2
