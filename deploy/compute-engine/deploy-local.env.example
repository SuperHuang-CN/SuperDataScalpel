# DataScalpel Local Docker Dispatcher 部署配置示例。
#
# 在 Windows 工程根目录执行：
#   deploy-datascalpel-compute-engine-linux69.cmd check   只检查，不部署。
#   deploy-datascalpel-compute-engine-linux69.cmd deploy  构建并部署；不传参数时也是此模式。
#
# 首次运行会把本文件复制为 deploy-local.env。该文件和生成的 connection-info.txt
# 包含密码或 Token，已被 Git 忽略。部署前必须替换所有 <set-me>，可选项允许留空。
# 如需使用其他配置文件，把环境变量 DATASCALPEL_DEPLOY_CONFIG 设为其绝对路径。

# -----------------------------------------------------------------------------
# 本机构建环境和远程主机（必填）
# -----------------------------------------------------------------------------

# 本机 Java 21 安装目录，脚本使用它运行 Maven Wrapper 构建。
LOCAL_JAVA_HOME=D:\Program Files\Eclipse Adoptium\jdk-21.0.11.10-hotspot

# ssh 命令可识别的目标，例如 ~/.ssh/config 中的别名或 root@host。
# 脚本需要管理 Docker 和 /data，因此远程登录用户必须是 root。
SSH_TARGET=linux69

# Admin 和运维人员访问远程 Dispatcher 使用的地址。脚本用它生成 dispatcherBaseUrl，
# 不会从 SSH_TARGET 自动推导。
REMOTE_HOST_IP=10.0.0.69

# 远程持久化安装根目录，必须是 /data 下的绝对路径。
REMOTE_ROOT=/data/datascalpel-compute-engine

# -----------------------------------------------------------------------------
# 构建 Dispatcher 运行时镜像使用的基础镜像（可选）
# -----------------------------------------------------------------------------

# 默认从 Docker Hub 拉取；远程主机无法访问 Docker Hub 时，改成镜像仓库的完整地址。
COMPUTE_ENGINE_DOCKER_CLI_IMAGE=docker:cli
COMPUTE_ENGINE_JAVA_RUNTIME_IMAGE=eclipse-temurin:21-jre-alpine

# -----------------------------------------------------------------------------
# 部署管理方式（Portainer 可选；否则使用 SSH Docker Compose）
# -----------------------------------------------------------------------------

# Portainer 模式：同时填写 PORTAINER_URL 和 PORTAINER_API_KEY，脚本会创建或更新
# 名为 datascalpel-compute-engine 的受管 Stack。
# SSH 模式：PORTAINER_URL、PORTAINER_API_KEY、PORTAINER_ENDPOINT_ID 全部留空，
# 脚本通过 SSH 执行 docker compose；Portainer 中可能显示为 external Stack。
PORTAINER_URL=
PORTAINER_API_KEY=

# Portainer Environment/Endpoint ID。只有 Portainer 恰好返回一个 Environment 时
# 才能留空，否则必须明确填写目标 ID。
PORTAINER_ENDPOINT_ID=

# true 表示本次部署允许访问 Windows 不信任证书的 Portainer HTTPS 地址。
# 有可信证书时应使用 false。
PORTAINER_SKIP_TLS_VERIFY=true

# -----------------------------------------------------------------------------
# Dispatcher 控制面
# -----------------------------------------------------------------------------

# Admin 调用 Dispatcher 管理接口使用的 Bearer Token。脚本首次创建 deploy-local.env
# 时会自动生成随机值；这是敏感信息，不要提交到 Git。
DATASCALPEL_TASK_DISPATCHER_TOKEN=

# true 表示 Dispatcher 自动创建缺失的 Kafka Topic，适合开发或封闭环境；
# 生产环境建议设为 false，并由运维预先创建 Topic。
DATASCALPEL_TASK_DISPATCHER_ENSURE_TOPICS=true

# -----------------------------------------------------------------------------
# Dispatcher PostgreSQL 执行账本
# -----------------------------------------------------------------------------

# 必须能从远程主机上的 Dispatcher 容器访问。
DATASCALPEL_DB_URL=jdbc:postgresql://home.superhuang.cn:5432/datascalpel

# 每个独立 Dispatcher 部署使用不同的 Schema。
DATASCALPEL_TASK_DISPATCHER_DB_SCHEMA=dispatcher69
DATASCALPEL_DB_USERNAME=datascalpel
DATASCALPEL_DB_PASSWORD=<set-me>

# -----------------------------------------------------------------------------
# Kafka
# -----------------------------------------------------------------------------

# Dispatcher 容器可以访问的 Broker 地址。
DATASCALPEL_KAFKA_BOOTSTRAP_SERVERS=home.superhuang.cn:9094

# 一次性 Runner 容器可以访问的 Broker 地址。网络路径一致时可与上一项相同。
DATASCALPEL_KAFKA_RUNNER_BOOTSTRAP_SERVERS=home.superhuang.cn:9094

# -----------------------------------------------------------------------------
# 私有 MinIO/S3 制品存储
# -----------------------------------------------------------------------------

# Dispatcher 使用的 Endpoint，以及写入临时 Runner 启动描述的 Endpoint。
# Dispatcher 和 Runner 网络路径不同时，可以配置成不同地址。
DATASCALPEL_FILE_STORAGE_ENDPOINT=http://home.superhuang.cn:9000
DATASCALPEL_FILE_STORAGE_RUNNER_ENDPOINT=http://home.superhuang.cn:9000
DATASCALPEL_FILE_STORAGE_REGION=us-east-1
DATASCALPEL_FILE_STORAGE_BUCKET=datascalpel
DATASCALPEL_FILE_STORAGE_ROOT_PREFIX=data-scalpel
DATASCALPEL_FILE_STORAGE_ACCESS_KEY=minioadmin
DATASCALPEL_FILE_STORAGE_SECRET_KEY=<set-me>

# MinIO 通常使用 true；其他 S3 兼容存储按服务商要求配置。
DATASCALPEL_FILE_STORAGE_PATH_STYLE_ACCESS=true

# -----------------------------------------------------------------------------
# Local Docker Runner
# -----------------------------------------------------------------------------

# 每次 Spark 执行使用的一次性 Runner 容器镜像，必须包含 Java 21 JDK。
DATASCALPEL_TASK_DISPATCHER_DOCKER_IMAGE=eclipse-temurin:21-jdk

# docker run 拉取策略，只支持 always、missing、never。
DATASCALPEL_TASK_DISPATCHER_DOCKER_PULL=missing

# Dispatcher 运行概览中显示的静态部署基线。每个任务真正使用的 --memory 和
# --cpus 来自 Admin 计算引擎的资源策略或任务资源申请，不由这两项决定。
DATASCALPEL_TASK_DISPATCHER_DOCKER_MEMORY=4g
DATASCALPEL_TASK_DISPATCHER_DOCKER_CPUS=2

# Runner JVM 基础参数。Dispatcher 会根据每次任务申请的 Driver 内存重新计算 -Xmx，
# 其他安全参数会继续保留。
DATASCALPEL_TASK_DISPATCHER_RUNNER_JAVA_OPTIONS=-Xms512m -Xmx3g

# -----------------------------------------------------------------------------
# Dispatcher 实例消息通道（由发现接口返回，Admin 不再手填）
# -----------------------------------------------------------------------------

# commandTopic 和 runnerEventTopic 在独立 Dispatcher 实例之间唯一；
# 同一个实例的多个执行目标共享这组通道。连接同一个 Admin 的实例共享 adminEventTopic。
DATASCALPEL_COMMAND_TOPIC=datascalpel.execution.command.linux69
DATASCALPEL_RUNNER_EVENT_TOPIC=datascalpel.runner.event.linux69
DATASCALPEL_ADMIN_EVENT_TOPIC=datascalpel.execution.event

# 在 Admin 注册 Dispatcher 时使用的准入策略：队列上限是最大等待数量；并发提交上限
# 限制同时调用执行后端的数量；在途上限限制已提交/运行应用数量，0 表示不额外限制。
DATASCALPEL_MAX_QUEUED_EXECUTIONS=100
DATASCALPEL_MAX_CONCURRENT_SUBMISSIONS=2
DATASCALPEL_MAX_IN_FLIGHT_APPLICATIONS=2
