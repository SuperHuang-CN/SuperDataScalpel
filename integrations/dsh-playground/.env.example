# Generate local secrets with scripts/setup.mjs; do not use these placeholders.
DSH_PLAYGROUND_ENABLED=true
DSH_PLAYGROUND_ALICE_PASSWORD=<unique password, at least 12 characters>
DSH_PLAYGROUND_BOB_PASSWORD=<different password, at least 12 characters>
DSH_PLAYGROUND_MCP_ALICE_TOKEN=<random secret, at least 32 characters>
DSH_PLAYGROUND_MCP_BOB_TOKEN=<different random secret, at least 32 characters>
# Compose supplies DSH_BRIDGE_URL=http://dsh:13080 and PLAYGROUND_ORIGIN=http://127.0.0.1:13081
# DATASCALPEL_DSH_BRIDGE_TOKEN is loaded from existing deploy/dsh/.env.bridge
