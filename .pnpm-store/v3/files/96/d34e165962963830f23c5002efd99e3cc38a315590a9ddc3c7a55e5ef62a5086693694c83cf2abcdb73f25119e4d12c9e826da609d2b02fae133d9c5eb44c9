.sas-script-workbench{background:#fff;border:1px solid #e5e7eb;border-radius:6px;flex-direction:column;height:100%;min-height:620px;display:flex;overflow:hidden}.sas-script-toolbar{border-bottom:1px solid #e5e7eb;justify-content:space-between;align-items:center;height:40px;padding:6px 10px;display:flex}.sas-script-main{border-bottom:1px solid #e5e7eb;flex:auto;grid-template-columns:minmax(0,1fr) 300px;min-height:360px;display:grid}.sas-script-editor{min-width:0;min-height:360px}.sas-script-request{background:#fafafa;border-left:1px solid #e5e7eb;flex-direction:column;gap:8px;padding:10px;display:flex}.sas-script-request textarea{resize:none;flex:auto;min-height:260px;font-family:ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,monospace}.sas-script-workbench .ant-tabs{flex:0 0 210px;min-height:0;padding:0 10px 8px}.sas-script-workbench .ant-tabs-content-holder{overflow:auto}.sas-script-output pre,.sas-script-console,.sas-script-sql-card pre,.sas-script-workbench .ant-alert pre{color:#e2e8f0;white-space:pre-wrap;background:#0f172a;border-radius:4px;margin:8px 0 0;padding:8px;font-family:ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,monospace;font-size:12px;overflow:auto}.sas-script-sql-list{width:100%}.sas-script-sql-card{border:1px solid #e5e7eb;border-radius:4px;width:100%;padding:8px}@media (width<=900px){.sas-script-main{grid-template-columns:1fr}.sas-script-request{border-top:1px solid #e5e7eb;border-left:0}}
